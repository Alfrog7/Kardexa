# Copia este archivo como .env (Git lo ignora). Lo usan docker-compose.yml y la API.
# Son credenciales SOLO para la base local; nunca uses estos valores en otro entorno.

DB_NAME=kardexa
DB_USER=kardexa
DB_PASSWORD=kardexa
DB_PORT=5432

# Si ya tienes un PostgreSQL instalado en el 5432, usa DB_PORT=5433.
# La API (backend) lee este mismo archivo: no hace falta configurar nada más.
# Para apuntar a otra base, define la URL completa:
# DB_URL=jdbc:postgresql://localhost:5432/kardexa

# Clave para firmar los tokens (mínimo 32 caracteres) y su duración en minutos.
# Sin JWT_SECRET se usa una clave de desarrollo: define la tuya fuera de local.
# JWT_SECRET=
# JWT_EXPIRATION_MINUTES=60
