# Copia este archivo como .env para cambiar los valores de docker-compose.yml.
# Son credenciales SOLO para la base local; nunca uses estos valores en otro entorno.

DB_NAME=kardexa
DB_USER=kardexa
DB_PASSWORD=kardexa
DB_PORT=5432

# Si cambias algo de lo anterior, el backend lo lee de estas variables:
# DB_URL=jdbc:postgresql://localhost:5432/kardexa
